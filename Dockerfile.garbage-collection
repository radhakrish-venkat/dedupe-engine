# Build stage
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the garbage collection service
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o garbage-collection-service ./cmd/garbage-collection-service

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS requests
RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/garbage-collection-service .

# Expose any necessary ports (if needed)
# EXPOSE 8080

# Run the garbage collection service
CMD ["./garbage-collection-service"] 